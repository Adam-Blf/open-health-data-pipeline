# No secret or API key is required to run this pipeline: the Open FINESS
# dataset is downloaded anonymously over HTTPS from a public URL.
# This file is kept as a placeholder for the documentation rule (every
# project ships an .env.example, even an empty one) and for any future
# optional configuration.

# Optional: override the default Open FINESS CSV export URL.
# FINESS_CSV_URL=https://static.data.gouv.fr/resources/open-finess/20250327-210757/finess-enrichi.csv

# Optional: override the default k-anonymity / l-diversity thresholds used
# by the pipeline (see health_pipeline/pipeline.py for defaults).
# K_THRESHOLD=5
# L_THRESHOLD=2
